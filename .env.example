# ========================================
# AI Plushie E-commerce - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ========================================
# DATABASE (Required)
# ========================================
# PostgreSQL connection string
# Format: postgresql://USERNAME@HOST:PORT/DATABASE
# Example: postgresql://myuser@localhost:5432/plushie_app
DATABASE_URL="postgresql://chiho@localhost:5432/plushie_app"

# ========================================
# STRIPE PAYMENT (Required for checkout)
# ========================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Use test keys (sk_test_...) for development
# IMPORTANT: Never commit real keys to git!

# Secret key (server-side only)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"

# Publishable key (client-side safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Webhook secret (get from: stripe listen --forward-to localhost:3002/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Base URL for Stripe redirects
# Development: http://localhost:3002
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3002"

# ========================================
# ADMIN ACCESS (Required for admin dashboard)
# ========================================
# Generate a secure random key: openssl rand -base64 32
# Change this before deploying to production!
ADMIN_KEY="change-this-to-a-secure-random-key"

# ========================================
# GOOGLE SHEETS (Optional - for admin bulk operations)
# ========================================
# Create a Google Cloud service account and download JSON credentials
# See: docs/GOOGLE_SHEETS_SETUP.md for detailed instructions

# Paste entire JSON credentials on a single line
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Spreadsheet ID from URL (after /d/ and before /edit)
# Example: https://docs.google.com/spreadsheets/d/ABC123XYZ/edit -> ABC123XYZ
# GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id-from-url"

# ========================================
# EMAIL (Required for order confirmations)
# ========================================
# Email service for order confirmations
# Get your API key from: https://resend.com/api-keys
# IMPORTANT: Never commit real API keys to git!

RESEND_API_KEY="re_your_resend_api_key_here"

# Alternative: SendGrid
# SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# ========================================
# VENMO PAYMENT (Optional - for QR code payments)
# ========================================
# Your Venmo username for receiving payments
# Customers scan QR code to pay this account
# IMPORTANT: This is live payment info - never commit real username if you want privacy

VENMO_USERNAME="your-venmo-username"

# ========================================
# NEXTAUTH (Future - if adding user authentication)
# ========================================
# NextAuth.js configuration
# Generate secret: openssl rand -base64 32

# NEXTAUTH_URL="http://localhost:3002"
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ========================================
# NOTES
# ========================================
# - This file should be copied to .env (which is gitignored)
# - Never commit .env to version control
# - Update environment variables in Vercel dashboard for production
# - Test keys are safe for development, use live keys only in production
# - See docs/STRIPE_SETUP.md for Stripe configuration guide
# - See docs/GOOGLE_SHEETS_SETUP.md for Google Sheets configuration guide
