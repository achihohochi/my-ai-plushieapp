#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Checking for secrets in staged files..."

# Check for common secret patterns
PATTERNS=(
  "RESEND_API_KEY=['\"]?re_[A-Za-z0-9]+"
  "STRIPE_SECRET_KEY=['\"]?sk_[A-Za-z0-9]+"
  "STRIPE_WEBHOOK_SECRET=['\"]?whsec_[A-Za-z0-9]+"
  "ADMIN_KEY=['\"]?[A-Za-z0-9+/=]{16,}"
  "password=['\"]?[^\s'\"]+['\"]?"
  "api[_-]?key=['\"]?[A-Za-z0-9]+"
  "secret=['\"]?[A-Za-z0-9+/=]+"
  "token=['\"]?[A-Za-z0-9]+"
)

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check each pattern
for pattern in "${PATTERNS[@]}"; do
  if echo "$STAGED_FILES" | xargs git diff --cached | grep -iE "$pattern" > /dev/null; then
    echo "❌ ERROR: Potential secret found in staged files!"
    echo "Pattern matched: $pattern"
    echo ""
    echo "Please remove secrets before committing."
    echo "Use environment variables instead."
    exit 1
  fi
done

# Check if .env files are being committed (except .env.example)
if echo "$STAGED_FILES" | grep -E "^\.env$|^\.env\.(local|production|development)$" > /dev/null; then
  echo "❌ ERROR: .env file in staged changes!"
  echo ""
  echo "Files detected:"
  echo "$STAGED_FILES" | grep -E "^\.env"
  echo ""
  echo "These files should never be committed."
  echo "Run: git reset HEAD .env"
  exit 1
fi

echo "✅ No secrets detected in staged files"
